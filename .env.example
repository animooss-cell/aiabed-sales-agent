# ============================================================
# تنظیمات ایجنت فروش هوشمند aiabed.ir
# این فایل را با نام .env ذخیره کنید و مقادیر را پر کنید
# ============================================================

# --- پنل ادمین سایت ---
ADMIN_EMAIL=your-admin@email.com
ADMIN_PASSWORD=your-admin-password

# --- Gemini API (برای تولید پاسخ هوشمند) ---
# از https://aistudio.google.com/app/apikey بگیرید (رایگان)
GEMINI_API_KEY=AIzaSy...

# --- تلگرام (برای ارسال از حساب شخصی @abedahm) ---
# از https://my.telegram.org بگیرید — راهنما در GUIDE.md
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890
TELEGRAM_PHONE=+989161002550
